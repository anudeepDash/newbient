# Firebase Client Configuration (Vite prefix)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Firebase Admin SDK Configuration (Serverless functions)
# Download the service account JSON from Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# Google SMTP Server Details (SMTP server to send branded emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=partnership@newbi.live
SMTP_PASS="your_gmail_app_password"
SMTP_FROM="Newbi Entertainment <partnership@newbi.live>"

# Service-Specific Aliases (Format: "Name <email>")
SMTP_FROM_TICKETS="Newbi Tickets <noreply@newbi.live>"
SMTP_FROM_SUPPORT="Newbi Support <noreply@newbi.live>"
SMTP_FROM_BILLING="Newbi Finance <partnership@newbi.live>"
SMTP_FROM_LEGAL="Newbi Legal <partnership@newbi.live>"
SMTP_FROM_SECURITY="Newbi Security <noreply@newbi.live>"
SMTP_FROM_PARTNERSHIP="Newbi Partnerships <partnership@newbi.live>"
SMTP_FROM_COLLABORATIONS="Newbi Collaborations <collaborations@newbi.live>"

# Service-Specific SMTP Credentials (Optional - Falls back to primary SMTP_USER/SMTP_PASS if not set)
# SMTP_USER_TICKETS=tickets@newbi.live
# SMTP_PASS_TICKETS=your_tickets_gmail_app_password
# SMTP_USER_SUPPORT=support@newbi.live
# SMTP_PASS_SUPPORT=your_support_gmail_app_password
# SMTP_USER_BILLING=billing@newbi.live
# SMTP_PASS_BILLING=your_billing_gmail_app_password

# Meta (Facebook/Instagram) & APIs
META_APP_ID=your_meta_app_id

# Instagram verification (docs/instagram-verification.md). Server-only, never VITE_.
# Step B, "Instagram API with Instagram Login" (Connect Instagram):
IG_APP_ID=your_instagram_app_id
IG_APP_SECRET=your_instagram_app_secret
IG_REDIRECT_URI=https://app.newbi.live/api/instagram/callback
# Step A, Business Discovery through Newbi's own Instagram Business account:
META_GRAPH_TOKEN=long_lived_page_or_system_user_token
NEWBI_IG_USER_ID=newbi_instagram_business_account_id
# META_GRAPH_VERSION=v21.0
# Signs the OAuth state (shared with the mail links) and guards the cron:
# LINK_SIGNING_SECRET=32_or_more_random_characters
# CRON_SECRET=random_string
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# EmailJS Configuration (Legacy client email fallback)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here


# Campaign outreach (docs/campaign-outreach.md). Server-only, never VITE_.
# Public application form: applications allowed per IP per window (a college can share one IP).
# OUTREACH_APPLY_LIMIT=20
# OUTREACH_APPLY_WINDOW_MIN=10
# LINK_SIGNING_SECRET (above) also salts the hashed IPs in rate_limits.
# Seed script only (npm run seed:outreach): the local Firestore emulator. Never a real project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# WhatsApp Cloud API (Meta). Used today for tickets and verification; outreach uses it from Phase 2.
# Keep the token here (Vercel env), never in code or Firestore.
# WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANG=en
