{
    "functions": {
        "api/og.js": {
            "includeFiles": "dist/**"
        },
        "api/forms.js": {
            "includeFiles": "dist/**"
        }
    },
    "redirects": [
        {
            "source": "/artistant",
            "has": [{ "type": "host", "value": "newbi.live" }],
            "destination": "https://artistant.in",
            "permanent": false
        },
        {
            "source": "/artistant",
            "has": [{ "type": "host", "value": "www.newbi.live" }],
            "destination": "https://artistant.in",
            "permanent": false
        },
        {
            "source": "/admin",
            "has": [{ "type": "host", "value": "artistant.in" }],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/admin",
            "has": [{ "type": "host", "value": "www.artistant.in" }],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/admin/:path*",
            "has": [{ "type": "host", "value": "artistant.in" }],
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/admin/:path*",
            "has": [{ "type": "host", "value": "www.artistant.in" }],
            "destination": "/",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-XSS-Protection", "value": "1; mode=block" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
                { "key": "Content-Security-Policy", "value": "default-src 'self' https://*.firebaseapp.com https://*.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google.com https://*.gstatic.com https://*.googleapis.com https://*.firebaseapp.com https://pagead2.googlesyndication.com; connect-src 'self' data: blob: https: wss:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https://*.firebaseapp.com https://*.google.com https://*.recaptcha.net" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/track",
            "destination": "/api/track.js"
        },
        {
            "source": "/api/track/:path*",
            "destination": "/api/track.js"
        },
        {
            "source": "/api/forms",
            "destination": "/api/forms.js"
        },
        {
            "source": "/",
            "has": [{ "type": "host", "value": "artistant.in" }],
            "destination": "/artistant"
        },
        {
            "source": "/",
            "has": [{ "type": "host", "value": "www.artistant.in" }],
            "destination": "/artistant"
        },
        {
            "source": "/giveaway/:slug",
            "destination": "/api/og?giveaway=:slug"
        },
        {
            "source": "/forms/:id",
            "destination": "/api/og?formId=:id"
        },
        {
            "source": "/form/:id",
            "destination": "/api/og?formId=:id"
        },
        {
            "source": "/proposal/:id",
            "destination": "/api/og?proposalId=:id"
        },
        {
            "source": "/invoice/:id",
            "destination": "/api/og?invoiceId=:id"
        },
        {
            "source": "/agreement/:id",
            "destination": "/api/og?agreementId=:id"
        },
        {
            "source": "/concertzone/:category/:slug",
            "destination": "/api/og?blogSlug=:slug"
        },
        {
            "source": "/community",
            "has": [{ "type": "query", "key": "gig" }],
            "destination": "/api/og"
        },
        {
            "source": "/community",
            "has": [{ "type": "query", "key": "gl" }],
            "destination": "/api/og"
        },
        {
            "source": "/community",
            "has": [{ "type": "query", "key": "form" }],
            "destination": "/api/og"
        },
        {
            "source": "/community-join",
            "has": [{ "type": "query", "key": "gig" }],
            "destination": "/api/og"
        },
        {
            "source": "/community-join",
            "has": [{ "type": "query", "key": "gl" }],
            "destination": "/api/og"
        },
        {
            "source": "/community-join",
            "has": [{ "type": "query", "key": "form" }],
            "destination": "/api/og"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "query",
                    "key": "event"
                }
            ],
            "destination": "/api/og"
        },
        {
            "source": "/creator",
            "destination": "/api/og?page=creator"
        },
        {
            "source": "/creator/join",
            "destination": "/api/og?page=creator-join"
        },
        {
            "source": "/creator-dashboard",
            "destination": "/api/og?page=creator-dashboard"
        },
        {
            "source": "/creator-dashboard/:path*",
            "destination": "/api/og?page=creator-dashboard"
        },
        {
            "source": "/verify-creator",
            "destination": "/api/og?page=verify-creator"
        },
        {
            "source": "/campaigns",
            "destination": "/api/og?page=campaigns"
        },
        {
            "source": "/campaign/:id",
            "destination": "/api/og?campaignId=:id"
        },
        {
            "source": "/concertzone",
            "destination": "/api/og?page=concertzone"
        },
        {
            "source": "/concertzone/:category",
            "destination": "/api/og?category=:category"
        },
        {
            "source": "/community",
            "destination": "/api/og?page=community"
        },
        {
            "source": "/community-join",
            "destination": "/api/og?page=community"
        },
        {
            "source": "/forms",
            "destination": "/api/og?page=forms"
        },
        {
            "source": "/form",
            "destination": "/api/og?page=forms"
        },
        {
            "source": "/doc/:id",
            "destination": "/api/og?docId=:id"
        },
        {
            "source": "/ticket/:id",
            "destination": "/api/og?ticketId=:id"
        },
        {
            "source": "/artistant",
            "destination": "/api/og?page=artistant"
        },
        {
            "source": "/contact",
            "destination": "/api/og?page=contact"
        },
        {
            "source": "/terms",
            "destination": "/api/og?page=terms"
        },
        {
            "source": "/privacy",
            "destination": "/api/og?page=privacy"
        },
        {
            "source": "/verify-payout",
            "destination": "/api/og?page=verify-payout"
        },
        {
            "source": "/register-payment",
            "destination": "/api/og?page=register-payment"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}